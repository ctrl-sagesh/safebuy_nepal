// SafeBuy Nepal — Firebase Storage Security Rules
// All evidence uploads are scoped to the uploader's userId.
// Files cannot be deleted; only re-uploaded.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Evidence files: evidence/{userId}/{reportId}/{filename}
    match /evidence/{userId}/{reportId}/{filename} {
      // Read: authenticated users only (signed URLs limit further)
      allow read: if request.auth != null;

      // Write: only the uploading user, with type and size constraints
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 && // 5 MB
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');

      // No deletes — evidence is preserved for fraud record integrity
      allow delete: if false;
    }

    // Profile images: profiles/{userId}/avatar.jpg
    match /profiles/{userId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024 && // 2 MB
        request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // KYC documents: kyc/{userId}/{fileName}
    // Selfie, citizenship, PAN card, and location photos.
    // Readable only by authenticated users (admin review); never deletable.
    match /kyc/{userId}/{fileName} {
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
      allow delete: if false;
    }

    // Payment QR codes: qr_codes/{userId}/{fileName}
    // Publicly readable so buyers can verify the locked QR. Never deletable.
    match /qr_codes/{userId}/{fileName} {
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size <= 2 * 1024 * 1024;
      allow read: if true;
      allow delete: if false;
    }

    // Review product images: review_images/{reviewId}/{fileName}
    match /review_images/{reviewId}/{fileName} {
      allow write: if request.auth != null &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if false;
    }
  }
}
